# 设置Expires头
<IfModule mod_expires.c>
	ExpiresActive On
	# 静态资源文件设置长期缓存
	<FilesMatch "^(favicon\.ico|tracking\.js|dark\.css|id_rsa\.pub|google028d8e7da5110e2c\.html|url-obfuscation\.js)$">
		ExpiresDefault "access plus 30 days"
	</FilesMatch>

	# 其他文件保持短期缓存
	<FilesMatch "^(index\.html|about\.html|friend-links\.html|README\.md|robots\.txt|sitemap\.xml)$">
		ExpiresDefault "access plus 4 hours"
	</FilesMatch>

	<Files "healthz">
		ForceType text/plain
		ExpiresDefault "access plus 1 minutes"
	</Files>
</IfModule>

<IfModule mod_headers.c>
	# 设置 HSTS
	Header set Strict-Transport-Security "max-age=31536000" env=HTTPS
	Header set X-Content-Type-Options nosniff
	<FilesMatch "^(tracking\.js|dark\.css|id_rsa\.pub|healthz|url-obfuscation\.js)$">
		# 设置 CORS 头部以允许跨域调用
		Header set Access-Control-Allow-Origin "*"
		Header set Access-Control-Allow-Methods "GET, OPTIONS"
		Header set Access-Control-Allow-Headers "Content-Type"
	</FilesMatch>
	<FilesMatch "\.(html|htm)$">
		# 设置 CSP 响应头
		Header set Content-Security-Policy "default-src 'self'; frame-ancestors 'self'; img-src https://avatars.githubusercontent.com/u/93070974 https://wapmz.com/cn/big/50 https://raw.githubusercontent.com/guguan123/CN_DCMS-Social/refs/heads/dev/favicon.ico https://emnasop.cn/4afc87cb-943a-4951-bc79-02833942edb8.png; script-src 'self' static.cloudflareinsights.com 'sha256-1Ge814fS5TCkqXHP+YWWESI2ySDyG72WXSqvoU6it0k=' *.clarity.ms; connect-src 'self' *.clarity.ms; style-src 'self' 'unsafe-inline'"
	</FilesMatch>
</IfModule>

# 将网站图标跳转到GitHub头像
<IfModule mod_alias.c>
	Redirect 301 /favicon.ico https://avatars.githubusercontent.com/u/93070974
</IfModule>

# 为SSH公钥文件设置正确的MIME type
<Files "id_rsa.pub">
	ForceType text/x-ssh-public-key
</Files>
